# En-têtes HTTP de Cloudflare Pages (ignoré par GitHub Pages).
# CSP : scripts et workers du site seulement ('wasm-unsafe-eval' pour Python et C++ compilés en
# WebAssembly), API Supabase, Cloudflare Turnstile ; aucune inclusion du site dans un cadre.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://bskgiaejgvbjpixijruk.supabase.co wss://bskgiaejgvbjpixijruk.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Fichiers de build à nom haché : cache permanent.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Python et Clang (WebAssembly, ~35 Mo) : versionnés par vendor/VERSION, cache d'une semaine.
/vendor/*
  Cache-Control: public, max-age=604800

# Énoncés et cours : rafraîchis à chaque déploiement.
/content/*
  Cache-Control: public, max-age=300, must-revalidate
