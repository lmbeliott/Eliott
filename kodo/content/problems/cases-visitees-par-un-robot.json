#.#.....#.....##.#.#.###.#.\n#...#...#..##..##....#...#..#.#...#...#.#.#.#.....\n#.#...#....##...#..#..##.......#..#...##..........\n.###.#........#.#...##.##..#..#...#.....#....#....\n.#.#......##.#...#...#...#..#.##.#.......#...#..#.\n#.#..#.#..##.##..#...##..#.#..#...#.#..####......#\n#........#.........#..#..##.#.#.......#......#....\n...#............##.........#.......###.#.#.#.#....\n..#.###.#....#...#...##.##..#.#..##......#.....##.\n#.........#.#...#.####.##..#...#.#..##.#.#....##.D\n..#..#..#..#..#....#.###.#.##..###.......#.#......\n.#...##..##....#........#...#.#..#........###..#..\n#..##....#.#......#.#..#.###..#....#..#....#....##\n#.......###...#...#.........##...####....###....##\n........#..#....#......#.#.....###....#..##...##..\n..#.....#...##....#..###............#...#.#.#.#...\n#...#........#.#..###.............##.....#.#..#.##\n..#.#.....#...#...##..#......#....#.#....#.###..#.\n..#.#.##.#.#.#...#.##..#....#....#..##....#...#...\n..##...#.#...#.#..##....#......#.....##.#......#.#\n#.#..#.....####.....#..........###.....#.#.....##.\n#..###.......#...#...##.#####..#......#.#...##....\n.....###...##.#....#...#.######..#.#....#..#.#.#.#\n##....###.#...........##.#...#.#####...#........##\n...#.#...........##.....##.#.##..##...#....#...#..\n..#..#...#....#...#..###.#.......#..#.....#...#...\n##.........#....##.##.....##.....#.......#...##.##\n......##.#..........##.#.#.....#..#....#.#..#.#..#\n..#....#.#....#...##....#.#..##.....#.....#...#...\n.........#..#.###...#.#.#....#.###...#..###..#....\n#......#........#..##.#...#.#.....#......#.##..#.#\n....##.......#....#..#.#.........#.#....#..#..##..\n#......##.#......##.##.##......#...###....#.......\n.#....#...#.#..#.#..#.#..#...#..#.....#........##.\n.#........#....#..#..#....##...#...#..##......#.#.\n#........#.....##...##......##....#..##.###..#.#..\n..#....##......#.#..#.##..##.......#....##.#..##.#\n.....#......#...#####.#..#......##.#....#.#..##..#\n##..#.#...#..#..#.##....#.#...##...#..........#